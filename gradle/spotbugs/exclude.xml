<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 排除规则：只收「理由明确、范围尽量窄」的豁免，新增必须写注释说明。
  能改代码修掉的一律改代码——例：VerifiedToken 的 List 字段改为构造期 List.copyOf 固化后，
  原先 4 条 EI_EXPOSE_REP/EI_EXPOSE_REP2 自动消失，不需要任何豁免。
-->
<FindBugsFilter>
  <!--
    EI_EXPOSE_REP2「构造器存下外部可变对象」对 Spring 容器管理的协作者不成立：
    service/config 层的构造参数由容器注入，按设计就是共享单例，做防御性拷贝反而破坏容器语义。
    范围只限这两个分层包 + 这一条规则；实体/DTO/业务对象持有外部可变引用的情况仍然照报。
    （注：更精确的 <Class annotation="org.springframework.stereotype.Service"/> 在 SpotBugs 4.10.4
    实测不生效，故按包名收敛。）
  -->
  <Match>
    <Class name="~com\.zen\..*\.(service|config)\..*"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    网关的另外三个包同样只持有容器注入的共享单例（ObjectMapper、ReactiveStringRedisTemplate），
    做防御性拷贝既无意义（ObjectMapper 的拷贝会丢掉 spring.jackson 配置）也没有出口（这些 Bean 由容器唯一持有）。
    逐包点名而不是放宽到整个 com.zen：JWT 与业务对象持有外部可变引用的情况仍然照报
    （对比 common-core 的 VerifiedToken 靠 List.copyOf 消掉 findings、没有走豁免）。
  -->
  <Match>
    <Class name="~com\.zen\.gateway\.(auth|error|filter)\..*"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    ecs 的 controller 与 presence 是同一条理由的两个新落点：构造参数只有容器注入的共享单例
    （DeviceService / DeviceGroupService / StringRedisTemplate），拷贝它们既无意义也没有出口。
    这里没有「改代码」这条路：被注入的 service 不能声明成 final，@Transactional 需要 CGLIB 代理它的子类，
    所以类型不可能被证明不可变——admin-service 的 AuthController 只是碰巧没被规则命中（SpotBugs 的
    不可变推断在 HeartbeatService/CommandDispatchService 上成立、在 DeviceService 上不成立），
    同一个形状两种结果，说明这条只能按包收敛，不该指望代码写法去躲。
    范围仍是「这一条规则 + 这两个包」，其它包持有外部可变引用照报。
  -->
  <Match>
    <Class name="~com\.zen\.ecs\.(controller|presence)\..*"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
